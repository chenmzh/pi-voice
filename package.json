{
  "name": "pi-voice",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local speech input and output for Pi, with optional ASR/TTS setup and a shared model service across windows",
  "keywords": ["pi-package", "voice", "asr", "tts", "qwen3-asr", "cosyvoice"],
  "repository": { "type": "git", "url": "https://github.com/chenmzh/pi-voice.git" },
  "homepage": "https://github.com/chenmzh/pi-voice#readme",
  "bugs": { "url": "https://github.com/chenmzh/pi-voice/issues" },
  "pi": { "extensions": ["./index.ts"] },
  "files": [
    "index.ts", "extension.ts", "controller.ts", "backend.ts", "audio.ts",
    "config.ts", "processes.ts", "pipeline.ts", "voices.ts", "native.ts", "shared.ts", "server.ts", "setup.ts",
    "python/worker.py", "python/requirements-asr.in", "python/requirements-tts.in", "python/build-constraints.in",
    "tools/voices.mjs", "tools/setup.py", "tools/daemon.mjs", "README.md", "PRIVACY.md", "config.example.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py'",
    "test:reload": "python3 tools/test-reload.py",
    "check:privacy": "node tools/check-privacy.mjs"
  },
  "engines": { "node": ">=22.18" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true } }
}
